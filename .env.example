# Backend API URL (used in next.config.js rewrites for /api and /uploads).
# Production default is hardcoded to the Railway backend in next.config.js.
# For LOCAL development, set this to your local backend:
NEXT_PUBLIC_API_URL=http://localhost:5001

# Public host serving uploaded images (must match backend S3_PUBLIC_URL when using R2/S3).
# NEXT_PUBLIC_UPLOADS_HOST=https://pub-<hash>.r2.dev
